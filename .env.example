# Banco (o docker-compose.yml já sobe um Postgres com estes dados)
DATABASE_URL=postgres://companheiros:companheiros@localhost:5432/companheiros

# Endereço público do app (usado nos links de login)
APP_URL=http://localhost:3000

# E-mail do link mágico. Sem SMTP_URL, o link aparece no terminal e na tela (só em desenvolvimento).
# Exemplo: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
EMAIL_FROM="Companheiros IA <nao-responda@exemplo.com>"
